# AuraMart Commerce OS — Production Environment Template (.env.production.example)

# App Configuration
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://auramart.com

# Authentication & Security (MANDATORY PRODUCTION SECRETS)
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_64_CHAR_SECRET
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# Database Configuration (PostgreSQL Mandatory)
DB_TYPE=postgres
DB_HOST=postgres.production.internal
DB_PORT=5432
DB_USER=auramart_prod_db_user
DB_PASSWORD=REPLACE_WITH_HIGH_ENTROPY_DB_PASSWORD
DB_NAME=auramart_production
DB_SSL=true
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000

# Payment Provider (stripe | razorpay | cod)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_LIVE_STRIPE_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_LIVE_STRIPE_WEBHOOK_SECRET
RAZORPAY_KEY_ID=rzp_live_REPLACE_WITH_LIVE_RAZORPAY_KEY
RAZORPAY_KEY_SECRET=REPLACE_WITH_LIVE_RAZORPAY_SECRET
RAZORPAY_WEBHOOK_SECRET=rzp_whsec_REPLACE_WITH_LIVE_RAZORPAY_WEBHOOK_SECRET

# Email Infrastructure (sendgrid | ses | smtp)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG.REPLACE_WITH_LIVE_SENDGRID_KEY
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SES_SMTP_USER
SMTP_PASS=REPLACE_WITH_SES_SMTP_PASSWORD
AWS_SES_REGION=us-east-1

# SMS Infrastructure (twilio | msg91 | textlocal)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=AC_REPLACE_WITH_TWILIO_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_TWILIO_AUTH_TOKEN
MSG91_AUTH_KEY=REPLACE_WITH_MSG91_AUTH_KEY

# Push Notifications (fcm | apns | expo)
PUSH_PROVIDER=fcm
FCM_PROJECT_ID=auramart-production-fcm
FCM_PRIVATE_KEY_PATH=/etc/auramart/fcm-key.json
APNS_TOPIC=com.auramart.customer

# Object Storage (s3 | r2)
STORAGE_PROVIDER=s3
AWS_S3_BUCKET=auramart-prod-media-assets
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_KEY

# Search Provider (typesense | meilisearch | sql)
SEARCH_PROVIDER=typesense
TYPESENSE_HOST=search.production.internal
TYPESENSE_API_KEY=REPLACE_WITH_TYPESENSE_PROD_API_KEY

# Analytics Provider (ga4 | posthog | firebase)
ANALYTICS_PROVIDER=ga4
GA4_MEASUREMENT_ID=G-LIVE1234567
POSTHOG_API_KEY=phc_REPLACE_WITH_POSTHOG_KEY

# Monitoring & Logging
MONITORING_PROVIDER=sentry
SENTRY_DSN=https://REPLACE_WITH_LIVE_SENTRY_DSN@sentry.io/123456
STRUCTURED_LOGGING=true
