# =============================================================================
# AuraMart Commerce OS — Production Environment Contract (.env.production.example)
# Documented environment contract for production deployments.
# DO NOT commit real secrets or production credentials to source control.
# =============================================================================

# Core Application Settings
NODE_ENV=production
PORT=5000
API_PUBLIC_URL=https://api.auramart.com/api/v1
FRONTEND_URL=https://auramart.com
VENDOR_URL=https://vendor.auramart.com
ADMIN_URL=https://admin.auramart.com
CORS_ORIGINS=https://auramart.com,https://vendor.auramart.com,https://admin.auramart.com

# Authentication & Session Security (MANDATORY IN PRODUCTION)
# Generate a high-entropy secret (e.g. openssl rand -base64 48)
JWT_SECRET=YOUR_PRODUCTION_HIGH_ENTROPY_JWT_SECRET_KEY_HERE
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=YOUR_PRODUCTION_HIGH_ENTROPY_REFRESH_TOKEN_SECRET_HERE

# Production PostgreSQL Database (MANDATORY IN PRODUCTION)
DB_HOST=your-postgres-instance.rds.amazonaws.com
DB_PORT=5432
DB_USER=auramart_admin
DB_PASSWORD=YOUR_PRODUCTION_DATABASE_PASSWORD_HERE
DB_NAME=auramart_prod
DB_SSL=true
# Or alternative connection string:
# DATABASE_URL=postgres://auramart_admin:PASSWORD@your-postgres-instance.rds.amazonaws.com:5432/auramart_prod?sslmode=require

# Payment Providers (EXTERNAL CONFIGURATION REQUIRED)
# Stripe Configuration
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_LIVE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SIGNING_SECRET

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_live_YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# Push Notifications (EXTERNAL CONFIGURATION REQUIRED)
# Path or stringified JSON of Google Firebase / Expo FCM service account
FCM_SERVICE_ACCOUNT_JSON=YOUR_FIREBASE_SERVICE_ACCOUNT_JSON_HERE

# Media & Storage (EXTERNAL CONFIGURATION REQUIRED)
STORAGE_BUCKET=auramart-media-production
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
STORAGE_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
