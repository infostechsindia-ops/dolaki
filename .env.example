# AuraMart Commerce OS — Development Environment Template (.env.example)

# App Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Authentication & Security
JWT_SECRET=auramart-secret-key-development-2026
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# Database Configuration (SQLite default for development)
DB_TYPE=sqlite
DB_NAME=auramart.db

# Payment Provider (stripe | razorpay | cod | generic)
PAYMENT_PROVIDER=generic
STRIPE_SECRET_KEY=sk_test_sandbox_key
STRIPE_WEBHOOK_SECRET=whsec_sandbox_secret
RAZORPAY_KEY_ID=rzp_test_sandbox_key
RAZORPAY_KEY_SECRET=rzp_test_secret
RAZORPAY_WEBHOOK_SECRET=rzp_whsec_sandbox

# Email Infrastructure (smtp | sendgrid | ses | sandbox)
EMAIL_PROVIDER=sandbox
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mailtrap_sandbox_user
SMTP_PASS=mailtrap_sandbox_password
SENDGRID_API_KEY=SG.sandbox_key
AWS_SES_REGION=us-east-1

# SMS Infrastructure (twilio | msg91 | textlocal | sandbox)
SMS_PROVIDER=sandbox
TWILIO_ACCOUNT_SID=AC_sandbox_sid
TWILIO_AUTH_TOKEN=auth_sandbox_token
MSG91_AUTH_KEY=msg91_sandbox_key
TEXTLOCAL_API_KEY=textlocal_sandbox_key

# Push Notifications (fcm | apns | expo | sandbox)
PUSH_PROVIDER=sandbox
FCM_PROJECT_ID=auramart-fcm-sandbox
APNS_TOPIC=com.auramart.customer

# Object Storage (s3 | r2 | local)
STORAGE_PROVIDER=local
AWS_S3_BUCKET=auramart-dev-uploads
R2_BUCKET_NAME=auramart-dev-r2

# Search Provider (typesense | meilisearch | sql)
SEARCH_PROVIDER=sql
TYPESENSE_HOST=localhost
TYPESENSE_API_KEY=ts_sandbox_key
MEILISEARCH_HOST=http://127.0.0.1:7700

# Analytics Provider (ga4 | firebase | posthog | console)
ANALYTICS_PROVIDER=console
GA4_MEASUREMENT_ID=G-SANDBOX123
POSTHOG_API_KEY=phc_sandbox_key

# Monitoring & Logging (sentry | opentelemetry | none)
MONITORING_PROVIDER=none
SENTRY_DSN=https://sandbox_key@sentry.io/123456
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
STRUCTURED_LOGGING=false
